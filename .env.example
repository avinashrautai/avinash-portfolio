# Supabase project settings (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Comma-separated Supabase Auth user IDs allowed into /admin.
ADMIN_USER_IDS=

# Optional public contact destination. Leave blank until a real address is selected.
NEXT_PUBLIC_CONTACT_EMAIL=

# Optional; used only by the deployment platform, never committed.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
